{
  "id": null,
  "uid": "bolt-node-health",
  "title": "Node Health",
  "tags": ["bolt", "node", "health"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "type": "stat",
      "title": "Health Status",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "bolt_node_health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Unhealthy", "color": "red"},
                "1": {"text": "Healthy", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "type": "stat",
      "title": "Sync Status",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "bolt_node_sync_status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Syncing", "color": "yellow"},
                "1": {"text": "Synced", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "type": "stat",
      "title": "Node Uptime",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "bolt_node_uptime_seconds / 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "type": "stat",
      "title": "Memory Usage",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nodejs_external_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MiB",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "type": "timeseries",
      "title": "CPU Usage",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity"
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "type": "timeseries",
      "title": "Memory Usage",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "nodejs_external_memory_bytes / 1024 / 1024",
          "legendFormat": "External",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity"
          },
          "unit": "MiB"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 12},
      "type": "stat",
      "title": "Storage Used",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "bolt_storage_size_bytes{type=\"total\"} / 1024 / 1024",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MiB",
          "decimals": 2,
          "noValue": "0"
        }
      }
    },
    {
      "id": 9,
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 12},
      "type": "stat",
      "title": "API Request Rate",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(bolt_api_requests_total[5m]) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/min",
          "decimals": 1,
          "noValue": "0"
        }
      }
    },
    {
      "id": 10,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "type": "logs",
      "title": "Recent Node Logs",
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{job=\"bolt\"} |~ \"INFO|WARN|ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    }
  ]
}