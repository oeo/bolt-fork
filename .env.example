# node environment
NODE_ENV=development

# network configuration (mainnet, testnet, devnet)
BOLT_NETWORK=mainnet

# ports
API_PORT=7333
P2P_PORT=7334
WS_PORT=7335
METRICS_PORT=7336

# redis connection
REDIS_URL=redis://localhost:7337

# storage backend (redis, memory, leveldb)
STORAGE_TYPE=redis

# logging
LOG_LEVEL=info

# mining
ENABLE_MINING=false
MINER_ADDRESS=

# p2p bootstrap nodes (comma separated)
BOOTSTRAP_NODES=

# monitoring
METRICS_ENABLED=true
GRAFANA_URL=http://localhost:7340
PROMETHEUS_URL=http://localhost:7338