# test environment variables
# usage: docker compose --env-file .env.test up

# redis test config
REDIS_PORT=7337
REDIS_ARGS=--maxmemory 256mb --maxmemory-policy allkeys-lru

# ipfs test config  
IPFS_PROFILE=test
IPFS_API_PORT=5002
IPFS_SWARM_PORT=4002
IPFS_GATEWAY_PORT=8081

# monitoring disabled for tests
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
LOKI_PORT=3101