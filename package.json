{
  "name": "bolt-fork",
  "version": "0.1.1",
  "packageManager": "bun@1.4.0",
  "description": "a proof of work blockchain",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "metrics": "bun run scripts/metrics-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:bats": "bats tests/bats/*.bats",
    "test:metrics": "bun test tests/unit/metrics.test.ts",
    "test:gbt": "bun test tests/unit/getblocktemplate.test.ts",
    "storage": "bun run scripts/storage.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "@scure/bip32": "2.3.0",
    "bip39": "3.1.0",
    "kubo-rpc-client": "7.1.0",
    "lmdb": "3.4.2",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.19",
    "typescript": "5.9.2"
  }
}
