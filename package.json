{
  "name": "bolt-fork",
  "version": "0.1.1",
  "description": "a proof of work blockchain",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "metrics": "bun run scripts/metrics-server.ts",
    "typecheck": "tsc --noEmit",
